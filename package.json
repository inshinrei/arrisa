{
  "name": "arrisa",
  "version": "0.1.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test && pnpm test:scripts",
    "typecheck": "tsc -b",
    "clean": "pnpm -r --filter './packages/*' exec rm -rf dist",
    "playground": "pnpm --filter @arrisa/playground dev",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "version:sync": "tsx scripts/version.ts sync",
    "version:bump": "tsx scripts/version.ts bump",
    "release:prepare": "pnpm test && pnpm typecheck && pnpm build && pnpm version:sync"
  },
  "author": "inshinrei",
  "license": "MIT",
  "description": "Arrisa — modular rich-text editor toolkit (document model, state, view, schema, collab)",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@typescript/typescript6": "^6.0.2",
    "ist": "1.1.7",
    "prettier": "3.9.5",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
